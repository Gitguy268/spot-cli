# Spot on a light terminal, room and hook.
Output docs/light.gif
Set Shell zsh
Set FontSize 18
Set Width 1200
Set Height 760
Set Padding 24
Set Theme "Catppuccin Latte"
Hide
Type "source docs/tapes/env.sh light" Enter
Sleep 4s
Show
Type "go test ./..." Enter
Sleep 2.5s
Screenshot docs/shot-light-hook.png
Type "spot" Enter
Sleep 2.5s
Screenshot docs/shot-light-room.png
Type "p"
Sleep 900ms
Screenshot docs/shot-light-pet.png
Type "q"
Sleep 500ms
